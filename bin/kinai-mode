#!/bin/sh

set -eu

# ====== 変数の宣言 ======
# ロケールの設定
export LC_ALL=C
export LANG=C

export POSIXLY_CORRECT=1

# wi-fiの状態を確認(空白除去)
wifi_status=$(nmcli -f WIFI g | awk 'NR == 2 {gsub(/[[:space:]]/,""); print}')
# bluetoothの状態を確認(空白除去)
bluetooth_status=$(bluetooth | awk '{gsub(/[[:space:]]/,"",$3); print $3}')
# このファイル自身のファイル名を取得
basename=$(basename "$0")
# ====== 変数の宣言ここまで ======


# "wifi_status"が"enabled"であれば真
if [ "${wifi_status}" = "enabled" ]; then

	# wifiを切る
	nmcli radio wifi off || true
	notify-send -t 3000 -u normal "${basename}" 'wi-fiをOFFにしました' >/dev/null 2>&1 || true

else

    notify-send -t 3000 -u normal "${basename}" 'wi-fiは既にOFFです' >/dev/null 2>&1 || true

fi

# "bluetooth_status"が"on"であれば真
if [ "${bluetooth_status}" = "on" ]; then

	# bluetoothを切る
	bluetooth off &&
	notify-send -t 3000 -u normal "${basename}" 'bluetoothをOFFにしました' >/dev/null 2>&1 || true

else

	notify-send -t 3000 -u normal "${basename}" 'bluetoothは既にOFFです' >/dev/null 2>&1 || true

fi
