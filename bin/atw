#!/bin/sh

set -eu

# デフォルトのAI CLIを設定
# 環境変数が設定されていればその値を使用
if [ -n "${DEFAULT_AI_CLI:-}" ]; then
    # 環境変数が設定されている場合、その値を使用
    :
else
    # 環境変数が設定されていない場合は、パスの通ったディレクトリからコマンドを探す
    DEFAULT_AI_CLI=""
    
    # 優先順位でコマンドをチェック
    for cmd in gemini qwen codex; do
        if command -v "$cmd" >/dev/null 2>&1; then
            DEFAULT_AI_CLI="$cmd"
            break
        fi
    done
    
    # 見つからない場合はエラーを出力して終了
    if [ -z "$DEFAULT_AI_CLI" ]; then
        echo "エラー: DEFAULT_AI_CLI環境変数が設定されており、gemini/qwen/codexのいずれもパスに存在しません" >&2
        exit 1
    fi
fi

export DEFAULT_AI_CLI

# tmuxセッション一覧を取得 (エラー時は空文字列)
get_tmux_sessions() {
    tmux ls 2>/dev/null || echo ""
}

# 指定セッションの状態を取得 (attached/detached/empty)
get_session_status() {
    session_name="${1}"
    tmux_sessions="${2}"

    echo "${tmux_sessions}" | awk -F':| ' -v name="${session_name}" '
        $1 == name {
            if ($NF == "(attached)") {
                print "attached"
            } else {
                print "detached"
            }
        }
    '
}

# ai_cliセッションが存在しない場合、新規作成してデフォルトCLIツールを起動
ensure_ai_cli_session() {
    session_name="ai_cli"
    status="${1}"

    if [ -z "${status}" ]; then
        tmux new-session -d -s "${session_name}"
        tmux send-keys -t "${session_name}" "${DEFAULT_AI_CLI}" C-m
    fi
}

# プロンプトを送信 (オプション -p)
send_prompt() {
    if [ "${1:-}" = "-p" ] && [ "${#}" -ge 2 ]; then
        shift
        prompt="${*}"
        tmux send-keys -t "ai_cli" "${prompt}" C-m
    fi
}

# メイン処理
main() {
    tmux_sessions="$(get_tmux_sessions)"
    ai_cli_status="$(get_session_status "ai_cli" "${tmux_sessions}")"
    ensure_ai_cli_session "${ai_cli_status}"
    send_prompt "$@"
}

main "$@"
