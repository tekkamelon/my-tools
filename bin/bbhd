#!/bin/sh

# デフォルトポート番号
PORT=80
HOST_DIR=""

# オプション解析
while getopts p:h opt; do
	case "${opt}" in
		p) PORT="${OPTARG}" ;;
		h) echo "Usage: $0 [-p PORT] host_dir" 1>&2; exit 1 ;;
		\?) echo "Invalid option: -${OPTARG}" 1>&2; exit 1 ;;
	esac
done
shift "$((OPTIND - 1))"

HOST_DIR="${1}"

# 引数の有無を確認,あれば真,なければ偽
if [ -n "${HOST_DIR}" ] ; then

	# 以降,変数が空の場合に実行を中止
	set -eu

	# 真の場合はhttpdを実行,失敗した場合は偽
	sudo busybox httpd -f -p "${PORT}" -h "${HOST_DIR}" ||

	# 偽の場合はエラーメッセージを表示
	echo "please enter the host directory" 1>&2

else

	# 偽の場合はエラーメッセージを表示
	echo "please enter the host directory" 1>&2

fi

