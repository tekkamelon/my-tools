#!/bin/sh

# デフォルトポート番号
PORT=80
HOST_DIR=""

# オプション解析
while [ "${#}" -ne 0 ]; do
	case "${1}" in
		-p)
			shift
			if [ "${#}" -eq 0 ]; then
				echo "Option -p requires an argument" 1>&2
				exit 1
			fi
			PORT="${1}"
			shift
			;;
		-h)
			echo "Usage: ${0} [-p PORT] host_dir" 1>&2
			exit 1
			;;
		-*)
			echo "Invalid option: ${1}" 1>&2
			exit 1
			;;
		*)
			if [ -n "${HOST_DIR}" ]; then
				echo "Too many non-option arguments" 1>&2
				exit 1
			fi
			HOST_DIR="${1}"
			shift
			;;
	esac
done

# 引数の有無を確認,あれば真,なければ偽
if [ -n "${HOST_DIR}" ] ; then

	# 以降,変数が空の場合に実行を中止
	set -eu

	# 真の場合はhttpdを実行,失敗した場合は偽
	sudo busybox httpd -f -p "${PORT}" -h "${HOST_DIR}" ||

	# 偽の場合はエラーメッセージを表示
	echo "please enter the host directory" 1>&2

else

	# 偽の場合はエラーメッセージを表示
	echo "please enter the host directory" 1>&2

fi

