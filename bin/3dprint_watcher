#!/bin/sh

set -eu

export LC_ALL=C
export LANG=C
export POSIXLY_CORRECT=1

working_dir=""
go2rtc_host=""

# 引数の解析
while [ "${#}" -gt 0 ]; do

	case "${1}" in
		-d)
			working_dir="${2}"
			shift 2
			;;
		-h)
			go2rtc_host="${2}"
			shift 2
			;;
		--help)
			cat <<- EOF
			Usage: 3dprint_watcher [options]

			Options:
			  -d <working_dir>  Working directory for the snapshot
			  -h <go2rtc_host>  go2rtc host IP address
			  --help            Show this help message and exit

			Examples:
			  3dprint_watcher -d /tmp -h 192.168.1.100
			EOF
			exit 0
			;;
		-*)
			echo "Error: Unknown option: ${1}" >&2
			exit 1
			;;
		*)
			echo "Error: Unexpected argument: ${1}" >&2
			exit 1
			;;
	esac

done

# 必要な引数が提供されているか確認
if [ -z "${working_dir}" ] || [ -z "${go2rtc_host}" ]; then

	echo "Usage: ${0} -d <working_dir> -h <go2rtc_host>" >&2
	exit 1

fi

# 作業ディレクトリに移動
cd "${working_dir}"

# 3Dプリントの監視カメラからのスナップショットを取得して保存
curl -s "http://${go2rtc_host}:1984/api/frame.jpeg?src=printer_cam" -o snapshot.jpg &&

qwen --yolo -p "@snapshot.jpg は3Dプリントの監視カメラからの画像です.これを用いて現在のプリント状態を判断してください.プリントが正常に進行している場合は特にアクションを起こす必要はありません.問題がある場合はopcliコマンドを適切に実行して下さい"

