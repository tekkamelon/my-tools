#!/bin/sh

set -eu
set -xv

# ====== 変数の設定 ======
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
export LANG=C
export POSIXLY_CORRECT=1

working_dir="${PWD}"
go2rtc_host="localhost"
# ====== 変数の設定ここまで ======


# ====== 関数の設定 ======
# ヘルプメッセージを表示する関数
show_help() {

	cat <<- EOF
	Usage: 3dprint_watcher [options]

	Options:
	  -d <working_dir>  Working directory for the snapshot
	  -h <go2rtc_host>  go2rtc host IP address
	  --help            Show this help message and exit

	Examples:
	  3dprint_watcher -d /tmp -h 192.168.1.100
	EOF

}
# ====== 関数の設定ここまで ======


# ====== メイン処理 ======
# 引数がない場合はヘルプを表示
if [ "${#}" -eq 0 ]; then

	show_help
	exit 0

fi

# 引数の解析
while [ "${#}" -gt 0 ]; do

	case "${1}" in
		-d)
			working_dir="${2}"
			shift 2
			;;
		-h)
			go2rtc_host="${2}"
			shift 2
			;;
		--help)
			show_help
			exit 0
			;;
		-*)
			echo "Error: Unknown option: ${1}" >&2
			exit 1
			;;
		*)
			echo "Error: Unexpected argument: ${1}" >&2
			exit 1
			;;
	esac

done

# 作業ディレクトリに移動
cd "${working_dir}"

# スナップショット画像を取得
if curl -s "http://${go2rtc_host}:1984/api/frame.jpeg?src=printer_cam" -o snapshot.jpg; then

	# 取得した画像をAIで分析
	qwen --yolo -p "@snapshot.jpg は3Dプリントの監視カメラからの画像です.これを用いて現在のプリント状態を判断してください.プリントが正常に進行している場合は特にアクションを起こす必要はありません.問題がある場合はopcliコマンドを適切に実行して下さい"

else

	# エラーメッセージを表示して終了
	echo "Error: Failed to fetch snapshot from ${go2rtc_host}" >&2
	exit 1

fi
# ====== メイン処理ここまで ======
