#!/bin/sh
# OctoPrint ジョブ制御CLIツール

set -eu

# ====== 変数の設定 ======
. /home/tekkamelon/.env
export LC_ALL=C
export LANG=C
export POSIXLY_CORRECT=1

HOST="${OCTOPRINT_HOST:-localhost}"
PORT="${OCTOPRINT_PORT:-80}"
API_KEY=""

# 改行とタブのみを区切り文字として扱う
IFS=$(printf '\n\t')

# ダウンローダ検出
if command -v wget >/dev/null 2>&1; then

	downloader="wget"

elif command -v curl >/dev/null 2>&1; then

	downloader="curl"

else

	printf 'Error: please install "wget" or "curl"\n' >&2
	exit 1

fi
# ====== 変数の設定ここまで ======


# ====== 関数の設定 ======
# GETリクエストを実行する関数
http_get() {

	url="${1}"
	api_key="${2}"

	case "${downloader}" in

		wget)
			wget -q -O - --header="X-Api-Key: ${api_key}" "${url}"
			;;
		curl)
			curl -s -X GET "${url}" -H "X-Api-Key: ${api_key}"
			;;
	esac

}

# POSTリクエストを実行する関数
http_post() {

	url="${1}"
	api_key="${2}"
	data="${3}"

	case "${downloader}" in

		wget)
			wget -q -O - \
				--post-data="${data}" \
				--header="Content-Type: application/json" \
				--header="X-Api-Key: ${api_key}" \
				"${url}"
			;;
		curl)
			curl -s -X POST "${url}" \
				-H "Content-Type: application/json" \
				-H "X-Api-Key: ${api_key}" \
				-d "${data}"
			;;
	esac

}

# 使用方法を表示する関数
usage() {
    cat <<- EOF
	Usage: opcli [options] COMMAND

	Options:
	  -h HOST    OctoPrint host (default: from OCTOPRINT_HOST env or localhost)
	  -p PORT    OctoPrint port (default: from OCTOPRINT_PORT env or 80)

	Commands:
	  status      Get current print job status
	  stop        Cancel the current print job
	  pause       Pause the current print job
	  resume      Resume the paused print job

	Environment variables:
	  OCTOPRINT_API_KEY    API key for OctoPrint
	  OCTOPRINT_HOST       Default host
	  OCTOPRINT_PORT       Default port
	EOF
}
# ====== 関数の設定ここまで ======


# ====== メイン処理 ======
# コマンドラインオプションの解析
while [ "${#}" -gt 0 ]; do

    case "${1}" in

        -h)
            HOST="${2}"
            shift 2
            ;;
        -p)
            PORT="${2}"
            shift 2
            ;;
        -*)
            printf 'Unknown option: %s\n' "${1}" >&2
            exit 1
            ;;
        *)
            break
            ;;

    esac

done

# 引数がない場合は使用方法を表示して終了
if [ ${#} -eq 0 ]; then

    usage
    exit 0

fi

# APIキーが環境変数に設定されていない場合はエラー
if [ -z "${OCTOPRINT_API_KEY:-}" ]; then

    printf 'Error: OCTOPRINT_API_KEY environment variable is not set\n' >&2
    exit 1

fi

API_KEY="${OCTOPRINT_API_KEY}"

# コマンドの取得
cmd="${1}"

# コマンドに応じた処理の実行
case "${cmd}" in

    status)
        # ステータス取得はGETリクエスト
        http_get "http://${HOST}:${PORT}/api/job" "${API_KEY}"
        ;;
    stop|cancel)
        payload='{"command":"cancel"}'
        ;;
    pause)
        payload='{"command":"pause","action":"pause"}'
        ;;
    resume)
        payload='{"command":"pause","action":"resume"}'
        ;;
    *)
        printf 'Unknown command: %s\n' "${cmd}" >&2
        usage
        exit 1
        ;;

esac

# POSTリクエストの実行（statusコマンド以外）
if [ "${cmd}" != "status" ]; then

    http_post "http://${HOST}:${PORT}/api/job" "${API_KEY}" "${payload}"

fi
# ====== メイン処理ここまで ======
